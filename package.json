{
  "name": "crm-pymes",
  "version": "1.0.0",
  "private": true,
  "description": "CRM para pequeñas empresas: contactos, embudo de ventas Kanban, tareas de seguimiento e indicadores.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "demo": "tsx server/demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.7",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
